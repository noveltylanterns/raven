# Local runtime data & configuration
/private/dat/**
!/private/dat/config.php.dist
!/private/dat/ext/
/private/dat/ext/*
!/private/dat/ext/.state.php.dist

# Uploaded media files (keep directory, ignore contents)
/public/uploads/*
!/public/uploads/.gitkeep

# Composer artifacts
/composer/
/vendor/
/composer.lock
/composer.phar

# Local temporary files
/tmp/
/.tmp/

# Local dev tools
/build/legacy/
/local/
/private/ext/debug-*/
/.codex

# Editor swap/backup artifacts
*.swp
*.swo
*~
